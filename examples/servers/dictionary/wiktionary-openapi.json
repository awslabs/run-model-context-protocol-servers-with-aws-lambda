{
  "openapi": "3.0.0",
  "info": {
    "title": "Wiktionary REST API",
    "version": "1.0.0",
    "description": "Wiktionary REST API for word definitions"
  },
  "servers": [
    {
      "url": "https://en.wiktionary.org/api/rest_v1"
    }
  ],
  "paths": {
    "/page/definition/{word}": {
      "get": {
        "summary": "Get word definition",
        "parameters": [
          {
            "name": "word",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Word definitions, grouped by language code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "partOfSpeech": {
                            "type": "string"
                          },
                          "language": {
                            "type": "string"
                          },
                          "definitions": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "definition": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
